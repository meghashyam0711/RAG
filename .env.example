# Everything is optional. Unset = "lite" mode (embedded stores, no LLM, offline embeddings).

# Where the index lives (default ~/.graphrag-mcp)
# GRAPHRAG_DATA_DIR=~/.graphrag-mcp

# --- Production stores (docker compose up -d) ---
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=graphrag-dev

# --- Internal LLM for extraction / grading / generation / verification ---
# auto picks Anthropic, then OpenAI, by which key is present; "none" forces extractive mode.
# GRAPHRAG_LLM_PROVIDER=auto
# GRAPHRAG_LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (Gemini, Ollama, vLLM, LM Studio):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GRAPHRAG_LLM_MODEL=gemini-2.5-flash

# --- Models ---
# GRAPHRAG_EMBEDDER=auto              # auto | fastembed | hash
# GRAPHRAG_DENSE_MODEL=BAAI/bge-small-en-v1.5
# GRAPHRAG_RERANKER=BAAI/bge-reranker-v2-m3

# --- Retrieval / loop tuning ---
# GRAPHRAG_CHUNK_TOKENS=800
# GRAPHRAG_VECTOR_K=15
# GRAPHRAG_FUSED_K=10
# GRAPHRAG_FINAL_K=5
# GRAPHRAG_GRAPH_HOPS=1
# GRAPHRAG_MAX_GRAPH_HOPS=2
# GRAPHRAG_MAX_RETRIES=2

# --- Transport ---
# GRAPHRAG_TRANSPORT=stdio            # stdio | streamable-http
# GRAPHRAG_HOST=127.0.0.1
# GRAPHRAG_PORT=8765
# GRAPHRAG_LOG_LEVEL=WARNING
